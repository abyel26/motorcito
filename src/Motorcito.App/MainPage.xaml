<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Motorcito.App"
             xmlns:ctl="clr-namespace:Motorcito.App.Controls"
             x:Class="Motorcito.App.MainPage"
             x:DataType="local:LiveDataViewModel"
             Title="Motorcito"
             BackgroundColor="#0E1512">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- Hero gauges, first on the page: this is the dashboard, and the
                 connection and export cards are setup UI around it.

                 Always visible, including before a connection — an empty dial
                 reads as an instrument waiting for input, where an empty page
                 reads as a broken app. Label, unit, range and easing come from
                 GaugeStyles at runtime rather than being set here, so there is
                 one source of truth and it can become per-vehicle later. -->
            <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignContent="Start">
                <ctl:GaugeView x:Name="RpmGauge" FlexLayout.Basis="50%" HeightRequest="165" />
                <ctl:GaugeView x:Name="SpeedGauge" FlexLayout.Basis="50%" HeightRequest="165" />
                <ctl:GaugeView x:Name="CoolantGauge" FlexLayout.Basis="50%" HeightRequest="165" />
                <ctl:GaugeView x:Name="OilGauge" FlexLayout.Basis="50%" HeightRequest="165" />
            </FlexLayout>

            <!-- Connection -->
            <Border BackgroundColor="#16211C" StrokeThickness="0" Padding="14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="CONNECTION" FontSize="11" TextColor="#6E8B7E" CharacterSpacing="1.5" />

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="3">
                        <Label Grid.Row="0" Grid.Column="0" Text="Status" TextColor="#8FA99A" FontSize="13" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Status}" TextColor="White" FontSize="13" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Adapter" TextColor="#8FA99A" FontSize="13" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding AdapterName}" TextColor="White" FontSize="13" />

                        <Label Grid.Row="2" Grid.Column="0" Text="Rate" TextColor="#8FA99A" FontSize="13" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding SampleRate}" TextColor="White" FontSize="13" />
                    </Grid>

                    <HorizontalStackLayout Spacing="10">
                        <Button x:Name="ConnectBtn" Text="Connect" Clicked="OnConnectClicked"
                                BackgroundColor="#2D6A4F" TextColor="White" CornerRadius="8"
                                HeightRequest="40" WidthRequest="120" FontSize="14" />
                        <Button x:Name="DisconnectBtn" Text="Disconnect" Clicked="OnDisconnectClicked"
                                BackgroundColor="#3A2A2A" TextColor="#E8C7C7" CornerRadius="8"
                                HeightRequest="40" WidthRequest="120" FontSize="14" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Phase 0 gate: the actual current milestone -->
            <Border BackgroundColor="#16211C" StrokeThickness="0" Padding="14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Label Text="PHASE 0 GATE" FontSize="11" TextColor="#6E8B7E" CharacterSpacing="1.5" />
                    <Label Text="{Binding GateVerdict}" TextColor="{Binding GateColor}" FontSize="14" />
                    <Label Text="{Binding CapabilitySummary}" TextColor="#8FA99A" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <!-- Vehicle -->
            <Border BackgroundColor="#16211C" StrokeThickness="0" Padding="14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                    <Label Grid.Row="0" Grid.ColumnSpan="2" Text="VEHICLE" FontSize="11"
                           TextColor="#6E8B7E" CharacterSpacing="1.5" Margin="0,0,0,4" />

                    <Label Grid.Row="1" Grid.Column="0" Text="VIN" TextColor="#8FA99A" FontSize="13" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Vin}" TextColor="White" FontSize="13" />

                    <Label Grid.Row="2" Grid.Column="0" Text="Codes" TextColor="#8FA99A" FontSize="13" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding DtcSummary}" TextColor="White" FontSize="13" />

                    <!-- Logging state. Visible because silent data collection that
                         has quietly stopped is worse than none: a user needs to be
                         able to tell at a glance that trips are being recorded. -->
                    <Label Grid.Row="3" Grid.Column="0" Text="Trip" TextColor="#8FA99A" FontSize="13" />
                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding TripStatus}" TextColor="White" FontSize="13" />

                    <!-- Where the oil gauge's value comes from, or why it has none,
                         so an "n/a" dial always has an explanation beside it. -->
                    <Label Grid.Row="4" Grid.Column="0" Text="Oil temp" TextColor="#8FA99A" FontSize="13" />
                    <Label Grid.Row="4" Grid.Column="1" Text="{Binding OilTempSource}" TextColor="White" FontSize="13" />

                    <!-- Required credit for catalog data in use; hidden when none is. -->
                    <Label Grid.Row="5" Grid.ColumnSpan="2" Text="{Binding SignalAttribution}"
                           IsVisible="{Binding HasSignalAttribution}"
                           TextColor="#6E8B7E" FontSize="11" Margin="0,4,0,0" />
                </Grid>
            </Border>

            <!-- Vehicle signals. What this car answered when asked, at connect, for
                 every manufacturer-specific value the catalogs define for it: live
                 values where the answer was plausible, and the reason otherwise. -->
            <Border BackgroundColor="#16211C" StrokeThickness="0" Padding="14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="VEHICLE SIGNALS" FontSize="11" TextColor="#6E8B7E" CharacterSpacing="1.5" />
                    <Label Text="{Binding SignalsSummary}" TextColor="#8FA99A" FontSize="12" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Signals}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:SignalRow">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}"
                                           TextColor="White" FontSize="13" />
                                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding Status}"
                                           TextColor="#6E8B7E" FontSize="11" />
                                    <Label Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Text="{Binding Value}"
                                           TextColor="White" FontSize="15" FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Export. Works whether or not an adapter is connected: analysing
                 last week's drives should not require being sat in the car. -->
            <Border BackgroundColor="#16211C" StrokeThickness="0" Padding="14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="EXPORT" FontSize="11" TextColor="#6E8B7E" CharacterSpacing="1.5" />
                    <Label Text="Share the logged data off this device for analysis."
                           TextColor="#8FA99A" FontSize="12" />
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Database" Clicked="OnExportDatabaseClicked"
                                BackgroundColor="#1E3A2E" TextColor="White"
                                CornerRadius="10" Padding="16,10" FontSize="14" />
                        <Button Text="CSV" Clicked="OnExportCsvClicked"
                                BackgroundColor="#1E3A2E" TextColor="White"
                                CornerRadius="10" Padding="16,10" FontSize="14" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Diagnostics. Records what the adapter actually replied, before
                 any parsing — the only place a decode bug is still visible,
                 since the rest of the database stores decoded values only. -->
            <Border BackgroundColor="#16211C" StrokeThickness="0" Padding="14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="DIAGNOSTICS" FontSize="11" TextColor="#6E8B7E" CharacterSpacing="1.5" />
                    <Label Text="Raw adapter replies. One-off commands and failures are always kept."
                           TextColor="#8FA99A" FontSize="12" />

                    <HorizontalStackLayout Spacing="10">
                        <Switch IsToggled="{Binding VerboseLogging}"
                                OnColor="#2E7D32" ThumbColor="White" />
                        <Label Text="Log every exchange" TextColor="White" FontSize="13"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label Text="{Binding DiagnosticSummary}" TextColor="#8FA99A" FontSize="12" />

                    <Button Text="Export adapter log" Clicked="OnExportDiagnosticLogClicked"
                            BackgroundColor="#1E3A2E" TextColor="White"
                            CornerRadius="10" Padding="16,10" FontSize="14"
                            HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <!-- Hero gauges. Declared statically because the XAML source
                 generator needs compile-time types, but each is shown only when
                 this car actually reports its PID — never assume one exists.
                 FlexLayout rather than a Grid so a missing parameter reflows
                 instead of leaving a hole where a dial should be. -->
            <Label Text="LIVE DATA" FontSize="11" TextColor="#6E8B7E" CharacterSpacing="1.5" Margin="4,4,0,0" />

            <!-- BindableLayout rather than CollectionView: this list is small,
                 fully known, and already inside a ScrollView. A CollectionView
                 here has unbounded height to measure against and its
                 virtualisation fights the outer scroller for no benefit. -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Gauges}" Spacing="2">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:GaugeItem">
                        <Grid ColumnDefinitions="*,Auto" Padding="14,10" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="{Binding Name}" TextColor="#C8DCD0" FontSize="14"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Value}" TextColor="White" FontSize="17"
                                   FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
